rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hanya akun student UNNES yang emailnya terverifikasi.
    function unnes() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@students\\.unnes\\.ac\\.id');
    }

    function sah() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nama','email','nim','done','buka','chk','ta','tat','log','skor','ident','updatedAt'])
        && d.email == request.auth.token.email
        && d.updatedAt == request.time
        && d.log.size() <= 30
        && d.ta.size() <= 20;
    }

    match /siswa/{uid} {
      allow read: if unnes() && request.auth.uid == uid;
      allow create, update: if unnes() && request.auth.uid == uid && sah();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
